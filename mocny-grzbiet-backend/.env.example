POSTGRES_DB=mocnygrzbiet
POSTGRES_USER=mocnygrzbiet
POSTGRES_PASSWORD=mocnygrzbiet_dev
DB_HOST=localhost
DB_PORT=5436
DB_NAME=mocnygrzbiet
DB_USER=mocnygrzbiet
DB_PASSWORD=mocnygrzbiet_dev
MAIL_HOST=localhost
MAIL_PORT=1027
MAIL_USERNAME=test@mocnygrzbiet.pl
MAIL_PASSWORD=test
MAIL_AUTH=false
MAIL_STARTTLS=false
# Real mail from your machine (e.g. to see the messages in a Gmail inbox): stack the gmail profile on
# dev and give it a Gmail address + an app password. dev alone always talks to MailHog.
# SPRING_PROFILES_ACTIVE=dev,gmail
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your_app_password
ADMIN_EMAIL=
# Konta techniczne/deweloperskie (CSV) — admin do testów, ukryte na liście użytkowników w panelu
ADMIN_HIDDEN_EMAILS=
JWT_SECRET=dev-secret-key-change-in-production-minimum-32-characters

# OAuth2 (optional - add 'oauth2' to SPRING_PROFILES_ACTIVE to enable)
# OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret
