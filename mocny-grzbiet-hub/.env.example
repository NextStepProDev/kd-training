# Database
POSTGRES_DB=mocnygrzbiet
POSTGRES_USER=mocnygrzbiet
POSTGRES_PASSWORD=CHANGE_TO_STRONG_PASSWORD

# Mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# OAuth2 - Google (optional - uncomment to enable)
# OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id
# OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret

# Admin
ADMIN_EMAIL=mocny.grzbiet@gmail.com
# Konta techniczne/deweloperskie (CSV) — admin do testów, ukryte na liście użytkowników w panelu
ADMIN_HIDDEN_EMAILS=

# JWT
JWT_SECRET=CHANGE_TO_RANDOM_KEY_MIN_32_CHARS

# GHCR (GitHub Container Registry)
GHCR_OWNER=nextstepprodev

# Deployment
VERSION=latest

# Application
CORS_ORIGINS=https://mocnygrzbiet.pl,https://www.mocnygrzbiet.pl
APP_BASE_URL=https://mocnygrzbiet.pl
SITE_URL=https://mocnygrzbiet.pl
